# Auto detect text files and perform LF normalization
* text=auto

# Documents
*.md text
*.txt text

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Scripts
*.js text eol=lf
*.json text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf

# Archives
*.tar.gz binary
*.zip binary
